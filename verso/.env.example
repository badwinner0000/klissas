# Modo local (padrão): as salas ficam em .data/ (arquivo). Nada precisa ser configurado.
# VERSO_DATA_DIR=./.data

# IA do modo solo (opcional). Sem chave, o par usa a escolha determinística por personalidade.
# A chave NUNCA vai para o navegador: só o servidor a lê.
# ANTHROPIC_API_KEY=
# VERSO_MODELO_IA=claude-haiku-5-5


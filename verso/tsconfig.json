{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "dom.iterable", "ES2022"], "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true, "resolveJsonModule": true,
    "noEmit": true, "jsx": "preserve", "incremental": true, "allowJs": true, "isolatedModules": true, "esModuleInterop": true,
    "types": ["node"], "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "src", "scripts", "tests", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "fontes"]
}
